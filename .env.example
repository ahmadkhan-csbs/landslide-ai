# Copy this file to .env and set credentials locally. Never commit .env.
# IMD integration is enabled only when both settings are supplied.
IMD_API_KEY=
# Set after confirming the subscribed endpoint in the IMD API portal.
IMD_WEATHER_URL=
# Optional request header name used by that endpoint (default: X-API-Key).
IMD_API_KEY_HEADER=X-API-Key

# Optional override only if NASA changes the public COOLR FeatureServer layer.
# Default layer discovery is automatic; do not put credentials here.
# COOLR_QUERY_URL=

# Required before the local admin verification panel can be used.
# Use a unique long password and a separate long random session secret.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional authority-dispatch settings. Do not add unofficial addresses.
# Configure SMTP plus only the state recipients that have authorised this use.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
AUTHORITY_EMAIL_ASSAM=
AUTHORITY_EMAIL_ARUNACHAL_PRADESH=
AUTHORITY_EMAIL_MANIPUR=
AUTHORITY_EMAIL_MEGHALAYA=
AUTHORITY_EMAIL_MIZORAM=
AUTHORITY_EMAIL_NAGALAND=
AUTHORITY_EMAIL_SIKKIM=
AUTHORITY_EMAIL_TRIPURA=

# Optional path to a local SQLite data store (default: data/weather_observations.sqlite3).
# LANDSLIDE_DB_PATH=
